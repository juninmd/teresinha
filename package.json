{
  "name": "teresinha",
  "version": "2.0.4",
  "description": "Teresinha é uma interface para verificar a versão do teresa.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juninmd/teresinha.git"
  },
  "author": "Antonio Carlos",
  "bugs": {
    "url": "https://github.com/juninmd/teresinha/issues"
  },
  "keywords": [
    "teresa",
    "client"
  ],
  "homepage": "https://github.com/juninmd/teresinha#readme",
  "license": "MIT",
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint"
    }
  },
  "scripts": {
    "clean": "scripts/clean.sh",
    "build": "tsc",
    "prepublishOnly": "tsc",
    "pretest": "tsc",
    "test": "jest --detectOpenHandles --forceExit --runInBand --passWithNoTests",
    "lint": "tslint --project .",
    "lint:fix": "tslint --project . --fix",
    "lint:test": "tslint '__tests__/**/*.ts?(x)' ",
    "lint:test:fix": "tslint '__tests__/**/*.ts?(x)' --fix"
  },
  "dependencies": {
    "@types/download": "^6.2.4",
    "axios": "^1.21.0",
    "commander": "15.0.0",
    "download": "8.0.0",
    "loading-indicator": "2.0.0",
    "node-cmd": "^6.0.1",
    "sudo": "^1.0.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tslint": "^6.1.3",
    "tslint-config-airbnb": "^5.11.1",
    "typescript": "^7.0.2"
  },
  "preferGlobal": true,
  "bin": {
    "teresinha": "index.js"
  }
}
